// Everything needed to run and check Nullbox: Rust, Node, pnpm, the GitHub CLI.
{
  "name": "Nullbox",
  // Node 22 as in .nvmrc. The full Debian image also brings the C compiler that bundled SQLite needs.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-trixie",
  "features": {
    // Same version as rust-toolchain.toml, so it's in the image instead of downloaded on first use.
    "ghcr.io/devcontainers/features/rust:1": { "version": "1.99.1" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  // Build output in volumes: much faster than a bind mount on macOS and Windows, and it hides
  // whatever the host built, since native Node modules from another OS don't run here.
  "mounts": [
    "source=${devcontainerId}-target,target=${containerWorkspaceFolder}/target,type=volume",
    "source=${devcontainerId}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${devcontainerId}-web-node-modules,target=${containerWorkspaceFolder}/apps/web/node_modules,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [5173, 3000],
  "portsAttributes": {
    "5173": { "label": "Web", "onAutoForward": "notify" },
    "3000": { "label": "API", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "biomejs.biome",
        "tamasfe.even-better-toml",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "rust-analyzer.check.command": "clippy",
        "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
        "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
        "[css]": { "editor.defaultFormatter": "biomejs.biome" },
        "[json]": { "editor.defaultFormatter": "biomejs.biome" }
      }
    }
  }
}
